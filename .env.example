# Konfiguracja SaaS SmartPanel CAD
# Skopiuj ten plik jako .env.local i uzupełnij kluczami ze swojego projektu Supabase

# URL Twojego projektu w Supabase (np. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Publiczny klucz anonimowy (anon public key)
VITE_SUPABASE_ANON_KEY=

# Flaga włączenia SaaS (true / false)
VITE_SAAS_ENABLED=true
