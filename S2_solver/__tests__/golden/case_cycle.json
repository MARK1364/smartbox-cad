{
  "name": "Cycle – trójkątny cykl więzów",
  "description": "Trzy obiekty połączone w cykl: A-B, B-C, C-A (więzy sprzeczne/przeciążone). PanelA jest ground (dist=0). Punkt spoczynku zależy od metody: Gauss-Seidel z under-relaxation ω=0.5 daje kompromis B=-1/3, C=+1/3 (Bx=-0.5/(2-ω)).",
  "contract": {
    "constraints": [
      {
        "constraint_id": "c1",
        "bind_type": "VERTEX",
        "enabled": true,
        "obj_a_id": "panelA",
        "obj_b_id": "panelB",
        "vert_a": 0,
        "vert_b": 0,
        "face_a": -1,
        "face_b": -1,
        "ground_mode": "VERTEX",
        "ground_pos": [0,0,0],
        "ground_normal": [0,0,1],
        "offset": 0.0
      },
      {
        "constraint_id": "c2",
        "bind_type": "VERTEX",
        "enabled": true,
        "obj_a_id": "panelB",
        "obj_b_id": "panelC",
        "vert_a": 1,
        "vert_b": 0,
        "face_a": -1,
        "face_b": -1,
        "ground_mode": "VERTEX",
        "ground_pos": [0,0,0],
        "ground_normal": [0,0,1],
        "offset": 0.0
      },
      {
        "constraint_id": "c3",
        "bind_type": "VERTEX",
        "enabled": true,
        "obj_a_id": "panelC",
        "obj_b_id": "panelA",
        "vert_a": 1,
        "vert_b": 1,
        "face_a": -1,
        "face_b": -1,
        "ground_mode": "VERTEX",
        "ground_pos": [0,0,0],
        "ground_normal": [0,0,1],
        "offset": 0.0
      }
    ],
    "ground_distance_map": {"panelA": 0, "panelB": 1, "panelC": 1}
  },
  "initial_states": {
    "panelA": {
      "id": "panelA",
      "location": [0, 0, 0],
      "rotation": [1, 0, 0, 0],
      "local_vertices": {
        "0": [0, 0, 0],
        "1": [1, 0, 0]
      },
      "local_faces": {}
    },
    "panelB": {
      "id": "panelB",
      "location": [2, 0, 0],
      "rotation": [1, 0, 0, 0],
      "local_vertices": {
        "0": [0, 0, 0],
        "1": [1, 0, 0]
      },
      "local_faces": {}
    },
    "panelC": {
      "id": "panelC",
      "location": [1, 1, 0],
      "rotation": [1, 0, 0, 0],
      "local_vertices": {
        "0": [0, 0, 0],
        "1": [1, 0, 0]
      },
      "local_faces": {}
    }
  },
  "expected_results": {
    "panelA": {
      "location": [0, 0, 0],
      "rotation": [1, 0, 0, 0]
    },
    "panelB": {
      "location": [-0.33333, 0, 0],
      "rotation": [1, 0, 0, 0]
    },
    "panelC": {
      "location": [0.33333, 0, 0],
      "rotation": [1, 0, 0, 0]
    }
  },
  "tolerances": {
    "position": 0.001,
    "angle_deg": 0.01
  }
}
