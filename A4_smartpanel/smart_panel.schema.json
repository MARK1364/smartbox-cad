{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "smartbox://A2_smartbox/smart_panel.schema.json",
  "title": "SmartBox Smart Panel Core Library Schema",
  "description": "Schemat dla A2_smartbox/smart_panel_V1.json (baza materials_database).",
  "type": "object",
  "required": [
    "metadata",
    "materials_database",
    "edge_banding_types"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["name", "version", "author"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "author": { "type": "string" }
      }
    },
    "materials_database": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/material_group"
      }
    },
    "edge_banding_types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/edge_banding"
      }
    }
  },
  "definitions": {
    "material_group": {
      "type": "object",
      "required": ["category_name", "default_thickness_mm", "density_kg_m3", "items"],
      "additionalProperties": false,
      "properties": {
        "category_name": { "type": "string" },
        "default_thickness_mm": { "type": "number", "exclusiveMinimum": 0 },
        "density_kg_m3": { "type": "number", "exclusiveMinimum": 0 },
        "items": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/material_item"
          }
        }
      }
    },
    "material_item": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" },
        "thickness_mm": { "type": "number", "exclusiveMinimum": 0 },
        "color_r": { "type": "number", "minimum": 0, "maximum": 1 },
        "color_g": { "type": "number", "minimum": 0, "maximum": 1 },
        "color_b": { "type": "number", "minimum": 0, "maximum": 1 },
        "price_key": { "type": "string" },
        "texture_path": { "type": "string" }
      }
    },
    "edge_banding": {
      "type": "object",
      "required": ["name", "prices_services"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "prices_services": { "type": "string" }
      }
    }
  }
}
