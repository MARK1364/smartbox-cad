  "ui_config": {
    "panel": {
      "label": {
        "pl": "Ustawienia Blend V2",
        "en": "Panel Settings V2",
        "de": "Blenden Einstellungen V2"
      },
      "parent": "VIEW3D_PT_SmartBox_Core",
      "box_type_filter": "PANELS"
    },
    "fields": {
      "side_panel_mode": {
        "type": "ENUM",
        "widget": "DROPDOWN",
        "label": {
          "pl": "Montaż blend",
          "en": "Panel mount mode",
          "de": "Blenden Montage"
        },
        "tooltip": {
          "pl": "Określa zakres wysokości blendy bocznej",
          "en": "Defines side panel height range"
        },
        "items": {
          "FULL": {
            "pl": "Cokół+korpus+blenda_G",
            "en": "Plinth+body+top"
          },
          "KORPUS_BLENDA_G": {
            "pl": "Korpus+blenda_G",
            "en": "Body+top"
          },
          "COKOL_KORPUS": {
            "pl": "Cokół+Korpus",
            "en": "Plinth+body"
          },
          "KORPUS": {
            "pl": "Korpus",
            "en": "Body only"
          }
        },
        "default": "FULL"
      },
      "enable_left": {
        "type": "BOOL",
        "widget": "CHECKBOX",
        "label": {
          "pl": "Blenda lewa",
          "en": "Left panel",
          "de": "Linke Blende"
        },
        "tooltip": {
          "pl": "Włącz blendę lewą",
          "en": "Enable left panel"
        },
        "default": true,
        "row": "left_panel_row"
      },
      "override_rear_left": {
        "type": "BOOL",
        "widget": "CHECKBOX",
        "label": {
          "pl": "Auto",
          "en": "Auto"
        },
        "tooltip": {
          "pl": "Automatyczna głębokość blendy lewej",
          "en": "Auto depth for left panel"
        },
        "default": true,
        "row": "left_panel_row",
        "show_if": {
          "field": "enable_left",
          "value": true
        }
      },
      "panel_depth_left": {
        "type": "FLOAT",
        "widget": "DRAG_NUMBER",
        "label": {
          "pl": "Głębokość lewa",
          "en": "Left depth",
          "de": "Linke Tiefe"
        },
        "default": 0.1,
        "min": 0.05,
        "unit": "LENGTH",
        "show_if": {
          "field": "override_rear_left",
          "value": false
        }
      },
      "enable_right": {
        "type": "BOOL",
        "widget": "CHECKBOX",
        "label": {
          "pl": "Blenda prawa",
          "en": "Right panel",
          "de": "Rechte Blende"
