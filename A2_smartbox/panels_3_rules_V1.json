        "default": true,
        "row": "right_panel_row"
      },
      "override_rear_right": {
        "type": "BOOL",
        "widget": "CHECKBOX",
        "label": {
          "pl": "Auto",
          "en": "Auto"
        },
        "default": true,
        "row": "right_panel_row",
