{
  "name": "crevo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "pretypecheck": "node scripts/pack-and-encrypt-rules.mjs",
    "typecheck:a2": "node scripts/typecheck-core.mjs",
    "typecheck:core": "node scripts/typecheck-core.mjs",
    "typecheck": "tsc --noEmit",
    "audit": "node scripts/audit-display-name-logic.mjs",
    "verify": "npm run typecheck && npm run test && npm run audit",
    "build:wasm:doors": "node scripts/build-wasm-doors.mjs",
    "build:wasm:drawers": "node scripts/build-wasm-drawers.mjs",
    "build:wasm:shelves": "node scripts/build-wasm-shelves.mjs",
    "build:wasm:flaps": "node scripts/build-wasm-flaps.mjs",
    "build:wasm:dividers": "node scripts/build-wasm-dividers.mjs",
    "build:wasm:tubes": "node scripts/build-wasm-tubes.mjs",
    "build:wasm:shelf": "node scripts/build-wasm-shelf.mjs",
    "build:wasm:panels": "node scripts/build-wasm-panels.mjs",
    "build:wasm:panel-brep": "node scripts/build-wasm-panel.mjs",
    "build:wasm:skosne-doors": "node scripts/build-wasm-skosne-doors.mjs",
    "build:wasm:corner-doors": "node scripts/build-wasm-corner-doors.mjs",
    "build:wasm:led": "node scripts/build-wasm-led.mjs",
    "build:wasm:hangers": "node scripts/build-wasm-hangers.mjs",
    "build:wasm:smartframe": "node scripts/build-wasm-smartframe.mjs",
    "build:wasm": "npm run build:wasm:doors && npm run build:wasm:drawers && npm run build:wasm:shelves && npm run build:wasm:flaps && npm run build:wasm:dividers && npm run build:wasm:tubes && npm run build:wasm:shelf && npm run build:wasm:panels && npm run build:wasm:panel-brep && npm run build:wasm:skosne-doors && npm run build:wasm:corner-doors && npm run build:wasm:led && npm run build:wasm:hangers && npm run build:wasm:smartframe",
    "build:vault": "node scripts/pack-and-encrypt-rules.mjs",
    "build": "npm run build:vault && npm run typecheck && vite build --outDir docs",
    "preview": "vite preview",
    "pretest": "node scripts/pack-and-encrypt-rules.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "repo-map": "node scripts/generate-repo-map.mjs"
  },
  "dependencies": {
    "@types/earcut": "^3.0.0",
    "earcut": "^3.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@langchain/langgraph": "^1.4.8",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.2.2",
    "vite": "^5.3.4",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10"
  }
}
