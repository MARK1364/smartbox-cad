{
  "name": "smartpanel-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck:a2": "node scripts/typecheck-core.mjs",
    "typecheck:core": "node scripts/typecheck-core.mjs",
    "typecheck": "tsc --noEmit",
    "audit": "node scripts/audit-display-name-logic.mjs",
    "verify": "npm run typecheck && npm run test && npm run audit",
    "build": "npm run typecheck && vite build --outDir docs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/earcut": "^3.0.0",
    "earcut": "^3.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@langchain/langgraph": "^1.4.8",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.2.2",
    "vite": "^5.3.4",
    "vitest": "^4.1.10"
  }
}
